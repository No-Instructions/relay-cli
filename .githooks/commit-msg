#!/usr/bin/env bash
set -euo pipefail

msg_file="$1"

first_line="$(grep -v '^#' "$msg_file" | sed -e '/./,$!d' | head -n 1)"

if [ -z "$first_line" ]; then
  exit 0
fi

pattern='^([a-z]+!?:|(fixup|squash|amend)! [a-z]+!?:)'
existing_prefixes='build, chore, ci, debug, deps, docs, feat, fix, fixup, flags, lint, perf, refactor, test, tools, types, ui, version, wip'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "commit-msg: subject must match '<type>[!]: <subject>' or '<fixup|squash|amend>! <type>[!]: <subject>' with a lowercase type; options: ${existing_prefixes}; got: ${first_line}" >&2
  exit 1
fi

# The public repo's history must stand alone: no bug-tracker ids, no test-plan
# ids, no wikilinks, no dev-tooling names, no agent session trailers.
# (Same bar as code comments.)
harness_pattern='(BUG-?[0-9]+|\bTP-?[0-9]{2,3}\b|\btp[0-9]{3}\b|\[\[|relay-harness|run-test-plan-suite|\bigit\b|\b(Codex|Claude)-Session[[:space:]]*:)'
if matches=$(grep -v '^#' "$msg_file" | grep -En "$harness_pattern"); then
  echo "commit-msg: message references internal tooling or tickets; describe the change on its own terms instead:" >&2
  echo "$matches" >&2
  exit 1
fi

exit 0
