{
  "name": "relay-cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Headless Relay sync for local folders",
  "type": "module",
  "bin": {
    "rmd": "./bin/rmd.js"
  },
  "scripts": {
    "build:headless": "node scripts/build-headless.mjs",
    "build:staging": "node scripts/build-headless.mjs staging",
    "check": "node --check bin/rmd.js && node --check src/cli.js && npm run build:headless",
    "pretest": "npm run build:headless",
    "test": "node --no-warnings --import ./scripts/configure-test-key.mjs --test __tests__/*.test.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.6.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@inquirer/prompts": "^7.10.1",
    "@noble/hashes": "1.8.0",
    "cbor-x": "^1.6.0",
    "diff": "^5.2.0",
    "diff-match-patch": "^1.0.5",
    "eventsource": "^2.0.2",
    "fake-indexeddb": "^6.0.1",
    "jose": "^5.3.0",
    "js-yaml": "^4.3.2",
    "lib0": "^0.2.114",
    "monkey-around": "^3.0.0",
    "node-diff3": "^3.2.0",
    "path-browserify": "^1.0.1",
    "pocketbase": "^0.20.3",
    "tslib": "2.4.0",
    "uuid": "^11.1.1",
    "y-protocols": "^1.0.5",
    "y-websocket": "^1.5.3",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.17.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
